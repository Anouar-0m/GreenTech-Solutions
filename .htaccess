
# BEGIN WordPress
# Les directives (lignes) entre « BEGIN WordPress » et « END WordPress » sont générées
# dynamiquement, et doivent être modifiées uniquement via les filtres WordPress.
# Toute modification des directives situées entre ces marqueurs sera surchargée.
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
RewriteBase /wordpress-6.9/wordpress/
RewriteRule ^index\.php$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /wordpress-6.9/wordpress/index.php [L]
</IfModule>

# END WordPress


<IfModule mod_rewrite.c>
    # Activer le moteur de réécriture d'URL
    RewriteEngine On

    # Vérifie si l'URL wp-json/wp/v2/users est appelée
    RewriteCond %{REQUEST_URI} ^/wordpress-6.9/wordpress/wp-json/wp/v2/users [NC]

    # Vérifie que l'utilisateur n'a pas de cookie de connexion
    RewriteCond %{HTTP:Cookie} !^(.*)(wordpress_logged_in_|wp-postpass_).*$ [NC]

    # Si les deux conditions sont remplies, renvoyer une erreur 401
    RewriteRule ^ - [R=401,L]
</IfModule>
